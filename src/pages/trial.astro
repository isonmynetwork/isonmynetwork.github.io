---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
---

<Layout title="Home Guardian 14-Day Trial - IsOnMyNet.Work">
  <main class="mt-28 mb-24 space-y-24">

    <!-- SECTION 1: HERO -->
    <Container>
      <section class="grid gap-12 lg:grid-cols-2 items-center">
        <div class="space-y-6">
          <span class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-sm font-semibold text-zinc-900">Home Guardian</span>
          <h1 class="text-4xl lg:text-5xl font-bold text-zinc-900">Try Home Guardian Free for 14 Days</h1>
          <p class="text-lg text-zinc-600">
            Protect your family's internet. Block ads, filter content, and control access — all from your phone. 
            Try it free for 14 days, then continue as a flexible monthly subscription.
          </p>
          <ul class="text-zinc-700 space-y-1">
            <li>✅ No credit card required</li>
            <li>✅ Full money-back guarantee</li>
            <li>✅ Setup in 30 minutes</li>
          </ul>
          <div class="flex items-center gap-4 pt-2">
            <a href="#trial-form" class="px-9 py-5 rounded-full border border-zinc-900 bg-zinc-900 text-white hover:text-[#B9FF66] transition duration-300 ease-in-out transform hover:scale-110">
              APPLY FOR 14-DAY TRIAL →
            </a>
            <span class="text-sm text-zinc-500">Only 
              <span class="inline-flex items-baseline gap-1">
                <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
                300
              </span> 
              refundable deposit
            </span>
          </div>
          <p class="text-xs text-zinc-500">
            After 14 days, continue from 
            <span class="inline-flex items-baseline gap-1">
              <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
              149
            </span>
            /month — cancel anytime.
          </p>
        </div>

        <div class="bg-white border border-zinc-200 rounded-3xl p-6 lg:p-10 shadow-card">
          <img src="/family-devices.png" alt="Family using devices" class="w-full rounded-2xl object-cover" loading="lazy" />
        </div>
      </section>
    </Container>

    <!-- SECTION 2: HOW IT WORKS -->
    <Container>
      <section class="space-y-10">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">How the Trial Works</h2>
        <div class="grid gap-6 lg:grid-cols-3">
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">1</div>
            <h3 class="mt-2 text-xl font-semibold">Apply Online</h3>
            <p class="mt-2 text-zinc-600">Fill out the form below. Takes 2 minutes.</p>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">2</div>
            <h3 class="mt-2 text-xl font-semibold">We Install</h3>
            <p class="mt-2 text-zinc-600">We schedule and install at your home. Takes ~30 minutes.</p>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">3</div>
            <h3 class="mt-2 text-xl font-semibold">Try for 14 Days</h3>
            <p class="mt-2 text-zinc-600">Love it? Keep it. Not for you? Full refund.</p>
          </div>
        </div>
      </section>
    </Container>

    <!-- SECTION 3: WHAT YOU'LL GET -->
    <Container>
      <section class="space-y-8">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">What's Included in Your Trial</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <ul class="space-y-4 text-zinc-800">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M11.48 3.499a1.5 1.5 0 0 1 1.04 0l6.75 2.7c.57.228.95.78.95 1.397v5.203a11.95 11.95 0 0 1-8.012 11.3.75.75 0 0 1-.517 0A11.95 11.95 0 0 1 3.75 12.799V7.596c0-.617.38-1.17.95-1.397l6.78-2.7Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Network-Wide Ad Blocking</strong> — enjoy a cleaner, faster internet with ads removed across all devices</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12 1.5a4.5 4.5 0 0 0-4.5 4.5V9H6a2.25 2.25 0 0 0-2.25 2.25v7.5A2.25 2.25 0 0 0 6 21h12a2.25 2.25 0 0 0 2.25-2.25v-7.5A2.25 2.25 0 0 0 18 9h-1.5V6A4.5 4.5 0 0 0 12 1.5ZM9 9V6a3 3 0 1 1 6 0v3H9Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Parental Controls</strong> — automatically block inappropriate websites and content for safer browsing</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12 1.5a10.5 10.5 0 1 0 0 21 10.5 10.5 0 0 0 0-21Zm-8.4 10.5a8.4 8.4 0 0 0 13.5 6.7L6.3 7.9a8.36 8.36 0 0 0-2.7 4.1Zm8.4-8.4a8.36 8.36 0 0 0-4.1 1.2l10.8 10.8a8.4 8.4 0 0 0-6.7-12Z" clip-rule="evenodd"/>
              </svg>
              <span>
                <strong>YouTube Ad Removal (Smart TV)</strong> — skip ads and sponsor segments on supported Smart TVs 
                <em class="text-zinc-500">(requires Smart TV with YouTube app)</em>
              </span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12.97 2.29a1.5 1.5 0 0 0-1.94 0l-7.5 6.5a1.5 1.5 0 0 0-.53 1.14V12a9 9 0 0 0 9 9h0a9 9 0 0 0 9-9V9.93c0-.43-.19-.84-.53-1.14l-7.5-6.5Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Safe Search Enforcement</strong> — keeps Google, Bing, and YouTube results family-friendly</span>
            </li>
          </ul>

          <ul class="space-y-4 text-zinc-800">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.75 3A.75.75 0 0 1 4.5 3v15.75H21a.75.75 0 0 1 0 1.5H3a.75.75 0 0 1-.75-.75V3.75A.75.75 0 0 1 3.75 3Z"/>
                <path d="M7.5 13.5A1.5 1.5 0 0 1 9 12h1.5a1.5 1.5 0 0 1 1.5 1.5V18H7.5v-4.5Zm6-3A1.5 1.5 0 0 1 15 9h1.5A1.5 1.5 0 0 1 18 10.5V18h-4.5v-7.5Z"/>
              </svg>
              <span><strong>Real-Time Statistics</strong> — instantly see what’s being blocked and monitor your family’s usage</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.42 3.06a3.9 3.9 0 0 0 5.52 4.9l2.3 2.3a1.5 1.5 0 0 1 0 2.12l-4.24 4.24a1.5 1.5 0 0 1-2.12 0l-2.3-2.3a3.9 3.9 0 0 0-4.9-5.52l2.12-2.12a1.5 1.5 0 0 1 2.12 0l.94.94a2.4 2.4 0 0 0 3.4-3.4l-.94-.94a1.5 1.5 0 0 1 0-2.12L11.42 3.06Z"/>
              </svg>
              <span><strong>Professional Installation</strong> — we handle everything for you, setup in under 30 minutes</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 3a8.25 8.25 0 0 0-8.25 8.25v1.5A2.25 2.25 0 0 0 6 15h.75v3.75A2.25 2.25 0 0 0 9 21h2.25a.75.75 0 0 0 .75-.75V18h.75v2.25c0 .414.336.75.75.75H16.5A2.25 2.25 0 0 0 18.75 18.75V15H19.5a2.25 2.25 0 0 0 2.25-2.25v-1.5A8.25 8.25 0 0 0 12 3Z"/>
              </svg>
              <span><strong>Full Support During Trial</strong> — WhatsApp and phone support included throughout your trial</span>
            </li>
          </ul>
        </div>

        <p class="text-sm text-zinc-500 italic pt-2">
          💡 Your 14-day trial includes the full Home Guardian service. After the trial, you can subscribe (from 
          <span class="inline-flex items-baseline gap-1">
            <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
            149
          </span>
          /month) or return the device for a full 
          <span class="inline-flex items-baseline gap-1">
            <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
            300
          </span> refund.
        </p>
      </section>
    </Container>

    <!-- (Form, testimonials, and other sections unchanged) -->

    <!-- SECTION: REFERRAL PROMPT -->
    <Container>
      <section class="text-center space-y-4 py-12 border-t border-zinc-200">
        <h2 class="text-2xl font-bold text-zinc-900">Already Using Home Guardian?</h2>
        <p class="text-zinc-600">
          Refer friends and family to protect their homes too — and earn 
          <span class="inline-flex items-baseline gap-1 font-semibold">
            <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
            100
          </span> 
          for each successful signup.
        </p>
        <a href="/referral/" 
           class="inline-flex items-center gap-2 px-7 py-4 rounded-full border border-zinc-900 bg-white text-zinc-900 hover:bg-zinc-900 hover:text-[#B9FF66] transition duration-300 ease-in-out transform hover:scale-105">
           LEARN ABOUT REFERRALS →
        </a>
      </section>
    </Container>

    <!-- FINAL CTA SECTION -->
    <Container>
      <section class="text-center space-y-6">
        <h2 class="text-3xl font-bold">Ready to Protect Your Family — Risk-Free?</h2>
        <p class="text-zinc-600">Join families across Dubai who are taking control of their children’s internet access.</p>
        <ul class="text-zinc-700">
          <li>✅ 14-day free trial</li>
          <li>✅ 
            <span class="inline-flex items-baseline gap-1">
              <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
              300
            </span> 
            fully refundable
          </li>
          <li>✅ No credit card required</li>
          <li>✅ Professional installation</li>
        </ul>
        <p class="text-sm text-zinc-500 italic">
          Free for 14 days, then optional subscription from 
          <span class="inline-flex items-baseline gap-1">
            <img src="/dirham.svg" alt="Dirham symbol" class="h-[1em] w-[1em] inline-block relative top-[0.15em]" />
            149
          </span> 
          /month — cancel anytime.
        </p>
        <div class="pt-2">
          <a href="#trial-form" class="px-9 py-5 rounded-full border border-zinc-900 bg-zinc-900 text-white hover:text-[#B9FF66] transition duration-300 ease-in-out transform hover:scale-110">START YOUR TRIAL NOW →</a>
        </div>
        <p class="text-sm text-zinc-500 flex flex-col sm:flex-row justify-center gap-1 sm:gap-2">
          <span>
            Questions? WhatsApp: 
            <a href="https://wa.me/971508776444" class="underline hover:text-[#B9FF66]">+971-50-877-6444</a>
          </span>
          <span>
            or Call: 
            <a href="tel:+971508779444" class="underline hover:text-[#B9FF66]">+971-50-877-9444</a>
          </span>
        </p>
      </section>
    </Container>

  </main>
</Layout>
