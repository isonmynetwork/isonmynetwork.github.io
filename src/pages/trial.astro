---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
---

<Layout title="Home Guardian 14-Day Trial - IsOnMyNet.Work">
  <main class="mt-28 mb-24 space-y-24">
    <!-- SECTION 1: HERO -->
    <Container>
      <section class="grid gap-12 lg:grid-cols-2 items-center">
        <div class="space-y-6">
          <span class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-sm font-semibold text-zinc-900">Home Guardian</span>
          <h1 class="text-4xl lg:text-5xl font-bold text-zinc-900">Try Home Guardian Free for 14 Days</h1>
          <p class="text-lg text-zinc-600">Protect your family's internet. Block ads, filter content, and control access — all from your phone.</p>
          <ul class="text-zinc-700 space-y-1">
            <li>✅ No credit card required</li>
            <li>✅ Full money-back guarantee</li>
            <li>✅ Setup in 30 minutes</li>
          </ul>
          <div class="flex items-center gap-4 pt-2">
            <a href="#trial-form" class="px-9 py-5 rounded-full border border-zinc-900 bg-zinc-900 text-white hover:text-[#B9FF66] transition duration-300 ease-in-out transform hover:scale-110">APPLY FOR 14-DAY TRIAL →</a>
            <span class="text-sm text-zinc-500">Only AED 300 refundable deposit</span>
          </div>
        </div>
        <div class="bg-white border border-zinc-200 rounded-3xl p-6 lg:p-10 shadow-card">
          <img src="/family-devices.png" alt="Family using devices" class="w-full rounded-2xl object-cover" loading="lazy" />
        </div>
      </section>
    </Container>

    <!-- SECTION 2: HOW IT WORKS -->
    <Container>
      <section class="space-y-10">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">How the Trial Works</h2>
        <div class="grid gap-6 lg:grid-cols-3">
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">1</div>
            <h3 class="mt-2 text-xl font-semibold">Apply Online</h3>
            <p class="mt-2 text-zinc-600">Fill out the form below. Takes 2 minutes.</p>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">2</div>
            <h3 class="mt-2 text-xl font-semibold">We Install</h3>
            <p class="mt-2 text-zinc-600">We schedule and install at your home. Takes ~30 minutes.</p>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">3</div>
            <h3 class="mt-2 text-xl font-semibold">Try for 14 Days</h3>
            <p class="mt-2 text-zinc-600">Love it? Keep it. Not for you? Full refund.</p>
          </div>
        </div>
      </section>
    </Container>

    <!-- SECTION 3: WHAT YOU'LL GET -->
    <Container>
      <section class="space-y-8">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">What's Included in Your Trial</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <ul class="space-y-4 text-zinc-800">
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: shield-check -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M11.48 3.499a1.5 1.5 0 0 1 1.04 0l6.75 2.7c.57.228.95.78.95 1.397v5.203a11.95 11.95 0 0 1-8.012 11.3.75.75 0 0 1-.517 0A11.95 11.95 0 0 1 3.75 12.799V7.596c0-.617.38-1.17.95-1.397l6.78-2.7Zm3.53 7.53a.75.75 0 1 0-1.06-1.06l-3.97 3.97-1.72-1.72a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.06 0l4.5-4.5Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Network-Wide Ad Blocking</strong> — no ads on phones, tablets, computers, or TVs</span>
            </li>
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: lock-closed -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 1.5a4.5 4.5 0 0 0-4.5 4.5V9H6a2.25 2.25 0 0 0-2.25 2.25v7.5A2.25 2.25 0 0 0 6 21h12a2.25 2.25 0 0 0 2.25-2.25v-7.5A2.25 2.25 0 0 0 18 9h-1.5V6A4.5 4.5 0 0 0 12 1.5ZM9 9V6a3 3 0 1 1 6 0v3H9Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Parental Controls</strong> — block inappropriate websites and content automatically</span>
            </li>
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: no-symbol -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 1.5a10.5 10.5 0 1 0 0 21 10.5 10.5 0 0 0 0-21Zm-8.4 10.5a8.4 8.4 0 0 0 13.5 6.7L6.3 7.9a8.36 8.36 0 0 0-2.7 4.1Zm8.4-8.4a8.36 8.36 0 0 0-4.1 1.2l10.8 10.8a8.4 8.4 0 0 0-6.7-12Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>YouTube Ad Removal</strong> — watch without interruptions on all devices</span>
            </li>
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: shield-exclamation -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.97 2.29a1.5 1.5 0 0 0-1.94 0l-7.5 6.5a1.5 1.5 0 0 0-.53 1.14V12a9 9 0 0 0 9 9h0a9 9 0 0 0 9-9V9.93c0-.43-.19-.84-.53-1.14l-7.5-6.5ZM12 8.25a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Safe Search Enforcement</strong> — Google, Bing, and YouTube safe search</span>
            </li>
          </ul>
          <ul class="space-y-4 text-zinc-800">
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: chart-bar -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3.75 3A.75.75 0 0 1 4.5 3v15.75H21a.75.75 0 0 1 0 1.5H3a.75.75 0 0 1-.75-.75V3.75A.75.75 0 0 1 3.75 3Z"/>
                <path d="M7.5 13.5A1.5 1.5 0 0 1 9 12h1.5a1.5 1.5 0 0 1 1.5 1.5V18H7.5v-4.5Zm6-3A1.5 1.5 0 0 1 15 9h1.5A1.5 1.5 0 0 1 18 10.5V18h-4.5v-7.5Z"/>
              </svg>
              <span><strong>Real-Time Statistics</strong> — see what's blocked and view reports</span>
            </li>
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: computer-desktop -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25v9A2.25 2.25 0 0 1 18.75 16.5H5.25A2.25 2.25 0 0 1 3 14.25v-9Z"/>
                <path d="M8.25 18h7.5a.75.75 0 0 1 0 1.5H13.5v.75a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1-.75-.75V19.5H8.25A.75.75 0 0 1 8.25 18Z"/>
              </svg>
              <span><strong>Device-Specific Rules</strong> — tailor controls per family member</span>
            </li>
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: wrench-screwdriver -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.42 3.06a3.9 3.9 0 0 0 5.52 4.9l2.3 2.3a1.5 1.5 0 0 1 0 2.12l-4.24 4.24a1.5 1.5 0 0 1-2.12 0l-2.3-2.3a3.9 3.9 0 0 0-4.9-5.52l2.12-2.12a1.5 1.5 0 0 1 2.12 0l.94.94a2.4 2.4 0 0 0 3.4-3.4l-.94-.94a1.5 1.5 0 0 1 0-2.12L11.42 3.06Z"/>
                <path d="M7.5 14.25 3 18.75V21h2.25l4.5-4.5-2.25-2.25z"/>
              </svg>
              <span><strong>Professional Installation</strong> — we handle everything</span>
            </li>
            <li class="flex items-start gap-3">
              <!-- Heroicons solid: headset -->
              <svg class="w-6 h-6 text-zinc-900 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 3a8.25 8.25 0 0 0-8.25 8.25v1.5A2.25 2.25 0 0 0 6 15h.75v3.75A2.25 2.25 0 0 0 9 21h2.25a.75.75 0 0 0 .75-.75V18h.75v2.25c0 .414.336.75.75.75H16.5A2.25 2.25 0 0 0 18.75 18.75V15H19.5a2.25 2.25 0 0 0 2.25-2.25v-1.5A8.25 8.25 0 0 0 12 3Z"/>
              </svg>
              <span><strong>Full Support During Trial</strong> — WhatsApp/phone support included</span>
            </li>
          </ul>
        </div>
      </section>
    </Container>

    <!-- SECTION 4: TRIAL REGISTRATION FORM -->
    <Container>
      <section id="trial-form" class="grid gap-10 lg:grid-cols-2 items-start">
        <div>
          <h2 class="text-3xl font-bold text-zinc-900">Apply for Your 14-Day Free Trial</h2>
          <p class="mt-2 text-zinc-600">Tell us a bit about yourself so we can ensure Home Guardian is right for your family.</p>
          <div class="mt-6 bg-white border border-zinc-200 rounded-3xl p-6 lg:p-8 shadow-sm">
            <form action="https://formbold.com/s/9xIPX" method="POST" class="space-y-6">
              <input type="hidden" name="redirect" value="/thank-you" />
              <h3 class="text-lg font-semibold">Your Information</h3>
              <div class="grid gap-4 lg:grid-cols-2">
                <div class="lg:col-span-2">
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="full_name">Full Name *</label>
                  <input id="full_name" name="full_name" required class="w-full rounded-xl border border-zinc-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#B9FF66]" placeholder="Jane Doe" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="phone">Phone Number *</label>
                  <input id="phone" name="phone" type="tel" required class="w-full rounded-xl border border-zinc-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#B9FF66]" placeholder="WhatsApp preferred" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="email">Email Address *</label>
                  <input id="email" name="email" type="email" required class="w-full rounded-xl border border-zinc-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#B9FF66]" placeholder="jane@example.com" />
                </div>
              </div>

              <h3 class="pt-2 text-lg font-semibold">About Your Family</h3>
              <div class="grid gap-4 lg:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="children_count">How many children? *</label>
                  <select id="children_count" name="children_count" required class="w-full rounded-xl border border-zinc-300 px-4 py-3 focus:outline-none">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5+">5+</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="children_ages">Ages of children *</label>
                  <input id="children_ages" name="children_ages" required class="w-full rounded-xl border border-zinc-300 px-4 py-3" placeholder="e.g., 8, 11, 14" />
                </div>
                <div class="lg:col-span-2">
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="devices_count">How many devices? *</label>
                  <select id="devices_count" name="devices_count" required class="w-full rounded-xl border border-zinc-300 px-4 py-3">
                    <option value="1-3">1-3</option>
                    <option value="4-6">4-6</option>
                    <option value="7-10">7-10</option>
                    <option value="10+">10+</option>
                  </select>
                </div>
              </div>

              <h3 class="pt-2 text-lg font-semibold">Your Concerns</h3>
              <div class="grid gap-3">
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="concern_screen_time" /> <span>Too much screen time</span></label>
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="concern_inappropriate" /> <span>Inappropriate content</span></label>
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="concern_social_media" /> <span>Social media addiction</span></label>
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="concern_gaming" /> <span>Gaming addiction</span></label>
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="concern_safety" /> <span>Online safety/privacy</span></label>
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="concern_ads" /> <span>Ads and distractions</span></label>
                <div>
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="concern_other">Other</label>
                  <input id="concern_other" name="concern_other" class="w-full rounded-xl border border-zinc-300 px-4 py-3" placeholder="Describe any other concerns" />
                </div>
              </div>

              <h3 class="pt-2 text-lg font-semibold">Installation Details</h3>
              <div class="grid gap-4">
                <div>
                  <label class="block text-sm font-medium text-zinc-700 mb-1" for="area">Area in Dubai *</label>
                  <select id="area" name="area" required class="w-full rounded-xl border border-zinc-300 px-4 py-3">
                    <option>Jumeirah</option>
                    <option>Dubai Marina</option>
                    <option>JLT</option>
                    <option>Business Bay</option>
                    <option>Downtown</option>
                    <option>Arabian Ranches</option>
                    <option>Other</option>
                  </select>
                </div>
                <fieldset class="grid gap-2">
                  <legend class="text-sm font-medium text-zinc-700 mb-1">Preferred installation time *</legend>
                  <label class="inline-flex items-center gap-2"><input type="radio" name="install_time" value="Weekday Morning" required /> Weekday Morning (9 AM - 12 PM)</label>
                  <label class="inline-flex items-center gap-2"><input type="radio" name="install_time" value="Weekday Afternoon" /> Weekday Afternoon (2 PM - 5 PM)</label>
                  <label class="inline-flex items-center gap-2"><input type="radio" name="install_time" value="Weekday Evening" /> Weekday Evening (6 PM - 9 PM)</label>
                  <label class="inline-flex items-center gap-2"><input type="radio" name="install_time" value="Weekend" /> Weekend (Saturday/Sunday)</label>
                </fieldset>
              </div>

              <h3 class="pt-2 text-lg font-semibold">Important Information</h3>
              <ul class="text-sm text-zinc-600 list-disc ml-5 space-y-1">
                <li>AED 300 refundable deposit required</li>
                <li>14-day trial period starts after installation</li>
                <li>If you keep it: AED 300 becomes setup fee; monthly from AED 149</li>
                <li>If not satisfied: Full AED 300 refund, no questions asked</li>
              </ul>

              <div class="grid gap-3 pt-2">
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="agree_terms" required /> I understand and agree to the trial terms *</label>
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="agree_deposit" required /> I'm ready to pay AED 300 deposit at installation *</label>
              </div>

              <div class="flex items-center justify-between pt-2">
                <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
                <button type="submit" class="px-7 py-3 rounded-2xl border border-zinc-900 bg-[#B9FF66] text-zinc-900 hover:bg-white transition duration-300 ease-in-out">Submit Application →</button>
              </div>
              <p class="text-xs text-zinc-500">By submitting, you agree to our Privacy Policy and Terms of Service.</p>
            </form>
          </div>
        </div>
        <div class="space-y-8">
          <!-- SECTION 5: WHAT HAPPENS NEXT -->
          <div class="bg-white border border-zinc-200 rounded-3xl p-6 lg:p-8 shadow-sm">
            <h3 class="text-2xl font-semibold">After You Submit...</h3>
            <div class="mt-4 space-y-4 text-zinc-700">
              <div>
                <div class="font-semibold">Within 2 Hours</div>
                <p>We call to confirm details, answer questions, and schedule installation.</p>
              </div>
              <div>
                <div class="font-semibold">Installation Day</div>
                <p>30-minute setup. Pay AED 300 deposit (cash/card). Quick walkthrough included.</p>
              </div>
              <div>
                <div class="font-semibold">During Your 14-Day Trial</div>
                <p>Full access, WhatsApp support, check-ins on Day 3 and Day 10.</p>
              </div>
              <div>
                <div class="font-semibold">Day 14 - Decision</div>
                <p>Keep it (AED 149/month) or uninstall and receive a full AED 300 refund.</p>
              </div>
            </div>
          </div>

          <!-- SECTION 6: FAQ -->
          <div class="bg-white border border-zinc-200 rounded-3xl p-6 lg:p-8 shadow-sm">
            <h3 class="text-2xl font-semibold">Frequently Asked Questions</h3>
            <div class="mt-4 space-y-4 text-zinc-700">
              <div>
                <div class="font-semibold">Is the AED 300 really refundable?</div>
                <p>Yes — 100% refund within 14 days if you return it. No questions asked.</p>
              </div>
              <div>
                <div class="font-semibold">Will it slow down my internet?</div>
                <p>No. Many customers report faster internet because ads are blocked.</p>
              </div>
              <div>
                <div class="font-semibold">What if my kids bypass it?</div>
                <p>It operates at the router level — cannot be bypassed without physical access.</p>
              </div>
              <div>
                <div class="font-semibold">Do I need technical knowledge?</div>
                <p>No. We install and set everything up. You just use it.</p>
              </div>
              <div>
                <div class="font-semibold">Can I control it remotely?</div>
                <p>Yes, with our Premium plan. We’ll explain during the trial.</p>
              </div>
              <div>
                <div class="font-semibold">What happens after 14 days?</div>
                <p>If you keep it, monthly service starts from AED 149. Cancel anytime with 30 days’ notice.</p>
              </div>
              <div>
                <div class="font-semibold">Do you cover my area?</div>
                <p>We cover all major areas of Dubai. We’ll confirm on the call.</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </Container>

    <!-- SECTION 7: SOCIAL PROOF (placeholder) -->
    <Container>
      <section class="space-y-6">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">What Parents Are Saying</h2>
        <div class="grid gap-6 lg:grid-cols-3">
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-yellow-500">★★★★★</div>
            <p class="mt-2 text-zinc-700">“Finally, no more fighting about TikTok at bedtime. I set it to block at 9 PM and it just works!”</p>
            <div class="mt-2 text-sm text-zinc-500">— Sarah M., Jumeirah</div>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-yellow-500">★★★★★</div>
            <p class="mt-2 text-zinc-700">“YouTube ads were driving us crazy. Now kids watch without constant interruptions.”</p>
            <div class="mt-2 text-sm text-zinc-500">— Ahmed K., Dubai Marina</div>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-yellow-500">★★★★★</div>
            <p class="mt-2 text-zinc-700">“Setup was 20 minutes and hassle-free. Haven’t had to touch it since.”</p>
            <div class="mt-2 text-sm text-zinc-500">— Fatima R., JLT</div>
          </div>
        </div>
      </section>
    </Container>

    <!-- SECTION 8: FINAL CTA -->
    <Container>
      <section class="text-center space-y-6">
        <h2 class="text-3xl font-bold">Ready to Protect Your Family?</h2>
        <p class="text-zinc-600">Join families across Dubai who are taking control of their children’s internet access.</p>
        <ul class="text-zinc-700">
          <li>✅ 14-day free trial</li>
          <li>✅ AED 300 fully refundable</li>
          <li>✅ No credit card required</li>
          <li>✅ Professional installation</li>
        </ul>
        <div class="pt-2">
          <a href="#trial-form" class="px-9 py-5 rounded-full border border-zinc-900 bg-zinc-900 text-white hover:text-[#B9FF66] transition duration-300 ease-in-out transform hover:scale-110">START YOUR TRIAL NOW →</a>
        </div>
        <p class="text-sm text-zinc-500">Questions? Call or WhatsApp: +971-50-877-9444</p>
      </section>
    </Container>
  </main>
</Layout>
