---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Dirham from '../components/Dirham.astro';
---

<Layout title="Refer a Friend – Home Guardian | IsOnMyNet.Work">
  <main class="mt-28 mb-24 space-y-24">

    <!-- HERO -->
    <Container>
      <section class="grid gap-12 lg:grid-cols-2 items-center">
        <div class="space-y-6">
          <span class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-sm font-semibold text-zinc-900">Referral Program</span>
          <h1 class="text-4xl lg:text-5xl font-bold text-zinc-900">
            Earn <Dirham />100 for Every Successful Referral
          </h1>
          <p class="text-lg text-zinc-600">
            Help your friends protect their families online with Home Guardian. For every successful signup you refer, you earn cash rewards.
          </p>
          <ul class="text-zinc-700 space-y-1">
            <li>✅ You earn <Dirham />100 per new subscriber</li>
            <li>✅ Your friend gets <Dirham />100 off setup or first month</li>
            <li>✅ Unlimited referrals — no cap</li>
          </ul>
          <p class="text-sm text-zinc-500">
            Only active subscribers are eligible. Rewards transferred within 7 days of payment clearing.
          </p>
        </div>

        <div class="bg-white border border-zinc-200 rounded-3xl p-6 lg:p-10 shadow-card">
          <img src="/referral-dirham.png" alt="Parents sharing referral link via phone" class="w-full rounded-2xl object-cover" loading="lazy" />
        </div>
      </section>
    </Container>

    <!-- HOW IT WORKS -->
    <Container>
      <section class="space-y-10">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">How It Works</h2>
        <div class="grid gap-6 lg:grid-cols-3">
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">1</div>
            <h3 class="mt-2 text-xl font-semibold">Share Your Code</h3>
            <p class="mt-2 text-zinc-600">Each subscriber gets a unique referral code. Share it with friends or family through WhatsApp or SMS.</p>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">2</div>
            <h3 class="mt-2 text-xl font-semibold">They Subscribe</h3>
            <p class="mt-2 text-zinc-600">
              When your friend joins Home Guardian as a new customer (not a trial user), they receive <Dirham />100 off.
            </p>
          </div>
          <div class="rounded-3xl border border-zinc-200 p-6 bg-white">
            <div class="text-5xl font-bold text-zinc-900">3</div>
            <h3 class="mt-2 text-xl font-semibold">You Earn</h3>
            <p class="mt-2 text-zinc-600">
              Once their payment clears, you receive <Dirham />100 cash within 7 days — no limits on referrals!
            </p>
          </div>
        </div>
      </section>
    </Container>

    <!-- FAQ -->
    <Container>
      <section class="space-y-8">
        <h2 class="inline-block rounded-2xl bg-[#B9FF66] px-4 py-2 text-2xl font-bold text-zinc-900">Referral FAQs</h2>
        <div class="grid gap-6 lg:grid-cols-2 text-zinc-700">
          <div><h3 class="font-semibold">Who can participate?</h3><p>Only existing Home Guardian subscribers can refer new users and earn rewards.</p></div>
          <div><h3 class="font-semibold">Can I refer someone who took a trial?</h3><p>No — trial users and previous customers are not eligible for rewards.</p></div>
          <div><h3 class="font-semibold">How do I get paid?</h3><p>Rewards are transferred directly to your account within 7 days of your referral’s first payment clearing.</p></div>
          <div><h3 class="font-semibold">Is there a referral limit?</h3><p>No limits — you can earn as much as you share!</p></div>
        </div>
      </section>
    </Container>

    <!-- CTA -->
    <Container>
      <section class="text-center space-y-6">
        <h2 class="text-3xl font-bold">Ready to Share Home Guardian?</h2>
        <p class="text-zinc-600">
          Help your friends protect their families and earn <Dirham />100 for every successful signup.
        </p>
        <div class="pt-2 flex justify-center">
          <a href="https://wa.me/971508776444?text=Hey!%20Check%20out%20Home%20Guardian.%20Use%20my%20referral%20code%20to%20get%20a%20discount!"
             target="_blank"
             class="inline-flex items-center gap-2 px-9 py-5 rounded-full border border-zinc-900 bg-zinc-900 text-white hover:text-[#B9FF66] transition duration-300 ease-in-out transform hover:scale-110">
             SHARE VIA WHATSAPP →
          </a>
        </div>
        <p class="text-sm text-zinc-500">
          Questions? WhatsApp: 
          <a href="https://wa.me/971508776444" class="underline hover:text-[#B9FF66]">+971-50-877-6444</a> 
          or Call: 
          <a href="tel:+971508779444" class="underline hover:text-[#B9FF66]">+971-50-877-9444</a>
        </p>
      </section>
    </Container>

  </main>
</Layout>
